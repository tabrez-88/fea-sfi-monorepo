    "validate:spec": "echo 'TODO: Implement OpenAPI spec validation'"
  },
  "devDependencies": {
    "@sfi-fea/eslint-config": "workspace:*",
    "@sfi-fea/tsconfig": "workspace:*",
    "eslint": "^8.57.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
