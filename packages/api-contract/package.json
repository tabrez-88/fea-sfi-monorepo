{
  "name": "@sfi-fea/api-contract",
  "version": "0.0.1",
  "private": true,
  "description": "API contract definitions and client generation for SFI-FEA",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
