# ===========================================
# SFI-API Staging Environment
# ===========================================
# This file is used for local staging testing with docker-compose
# Most secrets are loaded from GCP Secret Manager

# Node environment
NODE_ENV=staging

# Server Configuration
PORT=3001
HOST=0.0.0.0

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Auth — JWT lifetimes (non-secret; secrets come from GCP Secret Manager)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Auth — Mailtrap SMTP host/port (non-secret; user/pass come from GCP Secret Manager)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAIL_FROM=FEA-SFI <noreply@funkyland.io>

# GCP Project ID (numeric) - Required for Secret Manager
# Set this via environment variable or docker-compose
# GCP_PROJECT_ID=123456789

# Note: The following are loaded from GCP Secret Manager automatically (with _STAGING suffix):
# - DATABASE_URL          → DATABASE_URL_STAGING
# - DIRECT_URL            → DIRECT_URL_STAGING
# - JWT_ACCESS_SECRET     → JWT_ACCESS_SECRET_STAGING
# - JWT_REFRESH_SECRET    → JWT_REFRESH_SECRET_STAGING
# - MAILTRAP_USER         → MAILTRAP_USER_STAGING
# - MAILTRAP_PASS         → MAILTRAP_PASS_STAGING
# - APP_URL               → APP_URL_STAGING
# - CORS_ORIGIN           → CORS_ORIGIN_STAGING
# - LOG_LEVEL             → LOG_LEVEL_STAGING
# - FRONTEND_URL          → FRONTEND_URL_STAGING
# - GCS_BUCKET_NAME       → GCS_BUCKET_NAME_STAGING
