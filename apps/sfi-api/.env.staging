# ===========================================
# SFI-API Staging Environment
# ===========================================
# This file is used for local staging testing with docker-compose
# Most secrets are loaded from GCP Secret Manager

# Node environment
NODE_ENV=staging

# Server Configuration
PORT=3001
HOST=0.0.0.0

# API Configuration
API_PREFIX=api
API_VERSION=v1

# GCP Project ID (numeric) - Required for Secret Manager
# Set this via environment variable or docker-compose
# GCP_PROJECT_ID=123456789

# Note: The following are loaded from GCP Secret Manager automatically:
# - DATABASE_URL
# - DIRECT_URL
# - JWT_SECRET
# - JWT_REFRESH_SECRET
# - CORS_ORIGIN
# - LOG_LEVEL
# - FRONTEND_URL
# - GCS_BUCKET_NAME
