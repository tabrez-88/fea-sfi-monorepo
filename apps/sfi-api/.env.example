# ===========================================
# SFI-API Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# For staging/production, secrets are loaded from GCP Secret Manager

# Node environment: development | staging | production
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://sfi_user:your_secure_password_here@localhost:5432/sfi_fea_db?schema=public

# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Rate Limiting (requests per minute)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# ===========================================
# Settlement engine — feature flags
# ===========================================
# Gate the FB-003 Rule Snapshot v2 path (Rev 3 single-pipeline architecture
# with optional deduction layer + Allocation Target Layer + mode discriminator).
# When false (default), the API rejects any rule snapshot create with
# `schemaVersion: 2`. Engine still reads existing v2 snapshots regardless of
# the flag for verifiability. Flip to `true` only after staging QA validates
# the new path end-to-end.
SETTLEMENT_RULES_V2_ENABLED=true

# ===========================================
# Documents storage (FB-003 Run 4 / BE-FB003-DOCUMENTS-V1)
# ===========================================
# Storage backend — `local` (default) writes to STORAGE_LOCAL_PATH on disk.
# Future adapters (`gcs`, `s3`) slot in here when ready.
STORAGE_BACKEND=local

# Local filesystem root — where uploaded documents are written. Should be
# a mounted volume on a Contabo VM in production. Relative paths resolve
# from the API working directory.
STORAGE_LOCAL_PATH=./storage/documents

# Preview URL TTL — how long a signed/proxy preview URL stays valid.
# 900 = 15 minutes (per FB-003 Run 4 spec).
STORAGE_PREVIEW_URL_TTL_SECONDS=900

# Preview JWT secret — separate from auth tokens so a leaked preview token
# can never authenticate a session. Generate via `openssl rand -base64 64`.
# In dev, falls back to JWT_ACCESS_SECRET when unset.
STORAGE_PREVIEW_JWT_SECRET=

# Public-facing API base URL — used to build absolute preview proxy URLs
# returned in DocumentResponseDto.storageUrl.
API_BASE_URL=http://localhost:3001

# ===========================================
# Auth — JWT (access + refresh token strategy)
# ===========================================
# Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-strong-random-secret-min-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-different-strong-random-secret-min-64-chars
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Auth — Email (Mailtrap for dev / staging sandbox)
# ===========================================
# Sign up at https://mailtrap.io and grab the SMTP credentials from your inbox.
# Leave USER/PASS blank to log emails to console instead of sending.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
# Format: "Display Name <email@domain>" or just "email@domain"
MAIL_FROM=FEA-SFI <noreply@funkyland.io>

# Public-facing app URL — used to compose links inside emails (password reset, etc.)
APP_URL=http://localhost:3002

# ===========================================
# Auth — Avatar Storage (Cloud Bucket — pending)
# ===========================================
# Avatar upload is not yet wired. When the Cloud bucket is set up, fill in:
# AVATAR_BUCKET_NAME=
# AVATAR_BUCKET_REGION=
# AVATAR_PUBLIC_URL_PREFIX=https://storage.googleapis.com/<bucket-name>
# Until then, User.avatarUrl is always null.

# ===========================================
# Secrets provider (staging / production)
# ===========================================
# Select where the app reads its secret config from at boot:
#   - SECRETS_PROVIDER=env   → use process.env as-is (Contabo / self-hosted).
#                              Set DATABASE_URL, JWT_*, MAILTRAP_*, etc.
#                              directly in this file or via systemd /
#                              docker-compose. Default for new deployments.
#   - SECRETS_PROVIDER=gcp   → fetch secrets from GCP Secret Manager
#                              (keys suffixed _STAGING / _PRODUCTION).
#                              Requires GCP_PROJECT_ID.
#   - unset                  → back-compat auto-detect (uses GCP when
#                              NODE_ENV is staging/production AND
#                              GCP_PROJECT_ID is set; otherwise env).
SECRETS_PROVIDER=env

# Required only when SECRETS_PROVIDER=gcp:
#   GCP_PROJECT_ID=123456789

# When SECRETS_PROVIDER=gcp, these keys are fetched (suffixed by NODE_ENV):
#   DATABASE_URL, DIRECT_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET,
#   MAILTRAP_USER, MAILTRAP_PASS, APP_URL, CORS_ORIGIN, LOG_LEVEL, FRONTEND_URL

# ===========================================
# Contabo / self-hosted deployment notes
# ===========================================
# For a Contabo VM (or any plain VM):
#   1. Copy this file to /opt/sfi-fea/sfi-api/.env on the VM.
#   2. Fill in real values for DATABASE_URL, JWT_*, MAILTRAP_* (above).
#   3. Set SECRETS_PROVIDER=env so the app doesn't try to reach GCP.
#   4. Point STORAGE_LOCAL_PATH at a persisted/mounted directory
#      (e.g. /var/lib/sfi-fea/storage/documents).
#   5. Run via docker-compose (see docker-compose.yml in repo root).
# Full step-by-step in docs/deployment/CONTABO_MIGRATION_GUIDE.md.
