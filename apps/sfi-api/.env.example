# ===========================================
# SFI-API Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Node environment
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://sfi_user:your_secure_password_here@localhost:5432/sfi_fea_db?schema=public

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=debug

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Rate Limiting (requests per minute)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100
