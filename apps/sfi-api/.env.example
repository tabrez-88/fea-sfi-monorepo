# ===========================================
# SFI-API Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# For staging/production, secrets are loaded from GCP Secret Manager

# Node environment: development | staging | production
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://sfi_user:your_secure_password_here@localhost:5432/sfi_fea_db?schema=public

# CORS Configuration (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Logging: debug | info | warn | error
LOG_LEVEL=debug

# API Configuration
API_PREFIX=api
API_VERSION=v1

# Rate Limiting (requests per minute)
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# ===========================================
# Settlement engine — feature flags
# ===========================================
# Gate the FB-003 Rule Snapshot v2 path (Rev 3 single-pipeline architecture
# with optional deduction layer + Allocation Target Layer + mode discriminator).
# When false (default), the API rejects any rule snapshot create with
# `schemaVersion: 2`. Engine still reads existing v2 snapshots regardless of
# the flag for verifiability. Flip to `true` only after staging QA validates
# the new path end-to-end.
SETTLEMENT_RULES_V2_ENABLED=false

# ===========================================
# Auth — JWT (access + refresh token strategy)
# ===========================================
# Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=replace-with-strong-random-secret-min-64-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-different-strong-random-secret-min-64-chars
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Auth — Email (Mailtrap for dev / staging sandbox)
# ===========================================
# Sign up at https://mailtrap.io and grab the SMTP credentials from your inbox.
# Leave USER/PASS blank to log emails to console instead of sending.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASS=
# Format: "Display Name <email@domain>" or just "email@domain"
MAIL_FROM=FEA-SFI <noreply@funkyland.io>

# Public-facing app URL — used to compose links inside emails (password reset, etc.)
APP_URL=http://localhost:3002

# ===========================================
# Auth — Avatar Storage (Cloud Bucket — pending)
# ===========================================
# Avatar upload is not yet wired. When the Cloud bucket is set up, fill in:
# AVATAR_BUCKET_NAME=
# AVATAR_BUCKET_REGION=
# AVATAR_PUBLIC_URL_PREFIX=https://storage.googleapis.com/<bucket-name>
# Until then, User.avatarUrl is always null.

# ===========================================
# Staging/Production Only
# ===========================================
# These secrets are loaded from GCP Secret Manager when NODE_ENV=staging|production
# You only need to set GCP_PROJECT_ID as an environment variable

# GCP_PROJECT_ID=123456789  # Numeric project ID (required for staging/prod)

# The following are loaded automatically from GCP Secret Manager:
# - DATABASE_URL_STAGING / DATABASE_URL_PRODUCTION
# - DIRECT_URL_STAGING / DIRECT_URL_PRODUCTION
# - JWT_SECRET_STAGING / JWT_SECRET_PRODUCTION
# - JWT_REFRESH_SECRET_STAGING / JWT_REFRESH_SECRET_PRODUCTION
# - CORS_ORIGIN_STAGING / CORS_ORIGIN_PRODUCTION
# - LOG_LEVEL_STAGING / LOG_LEVEL_PRODUCTION
# - FRONTEND_URL_STAGING / FRONTEND_URL_PRODUCTION
# - GCS_BUCKET_NAME_STAGING / GCS_BUCKET_NAME_PRODUCTION
