{
  "name": "sfi-fea",
  "version": "0.0.1",
  "private": true,
  "description": "SFI-FEA Monorepo - Settlement & Financial Infrastructure",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@sfi-fea/api",
    "dev:fea": "turbo run dev --filter=@sfi-fea/fea",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=@sfi-fea/api",
    "build:fea": "turbo run build --filter=@sfi-fea/fea",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate --filter=@sfi-fea/api",
    "db:migrate": "turbo run db:migrate --filter=@sfi-fea/api",
    "db:push": "turbo run db:push --filter=@sfi-fea/api",
    "db:studio": "turbo run db:studio --filter=@sfi-fea/api",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
